{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "web/",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "backend": {
      "root": "agent-service/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "queues": {
      "root": "queue-service/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ],
      "functions": {
        "app/api/queues/process-inbound/route.ts": {
          "maxDuration": 300,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "zapwallet-inbound",
              "retryAfterSeconds": 30,
              "initialDelaySeconds": 0
            }
          ]
        },
        "app/api/queues/finalize/route.ts": {
          "maxDuration": 300,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "zapwallet-finalize",
              "retryAfterSeconds": 60,
              "initialDelaySeconds": 0
            }
          ]
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/admin/(.*)", "destination": { "service": "backend" } },
    { "source": "/webhook", "destination": { "service": "backend" } },
    { "source": "/webhooks/(.*)", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "crons": [
    { "path": "/api/cron/materialize-recurring", "schedule": "0 9 * * *" },
    { "path": "/api/cron/reset-monthly", "schedule": "5 3 1 * *" }
  ]
}
