web: uvicorn app.main:app --host 0.0.0.0 --port $PORT
worker-inbound: celery -A app.celery_app.celery worker --queues=inbound --concurrency=8 --loglevel=info --hostname=inbound@%h
worker-agent: celery -A app.celery_app.celery worker --queues=agent,celery --concurrency=4 --loglevel=info --hostname=agent@%h
beat: celery -A app.celery_app.celery beat --loglevel=info --scheduler celery.beat.PersistentScheduler --schedule /tmp/celerybeat-schedule
